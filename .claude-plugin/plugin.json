{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "internet-archive-mcp-server",
  "version": "0.1.5",
  "description": "Search the Wayback Machine and IA library (40M+ items), fetch archived snapshots, retrieve item metadata and full text via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads/internet-archive-mcp-server#readme"
  },
  "homepage": "https://github.com/cyanheads/internet-archive-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/internet-archive-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "internet-archive", "wayback-machine", "archive"],
  "mcpServers": {
    "internet-archive-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/internet-archive-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
